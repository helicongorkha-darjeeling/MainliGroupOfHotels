# Browser-safe Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase publishable key. Do not use the service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret/service-role key for trusted booking operations.
SUPABASE_SECRET_KEY=

# Server-only Razorpay test-mode credentials. Live keys must not be used until launch approval.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public origin used for absolute links, for example http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must remain "preview" until rates, payment policy, policies, and inventory are approved.
BOOKING_MODE=preview

# Secret required by an external scheduler calling /api/cron/expire-holds.
CRON_SECRET=

# Optional deployment identifier included in readiness output (for example the Git commit SHA).
APP_RELEASE=

# Approved payment policy only: full or deposit. Leave blank during preview.
PAYMENT_POLICY=

# Deposit percentage only when PAYMENT_POLICY=deposit and the owner has approved it.
DEPOSIT_PERCENT=
